# === ResultApp Provisioning Service — Environment Template ===
# Copy to .env on your DigitalOcean Droplet and fill values
# DO NOT commit .env to git

# --- API Security ---
# Shared secret validated via X-API-SECRET-KEY header from Next.js
API_SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
# Optional: allow provisioning without header in dev only
ENV=production

# --- PostgreSQL (local Droplet instance) ---
PG_HOST=localhost
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=superuser-password
PG_SUPERUSER_DB=postgres
# Optional: enforce SSD-friendly template
PG_ENCODING=UTF8
PG_TEMPLATE=template0

# --- Filesystem / RosarioSIS ---
# Absolute path to the read-only RosarioSIS template cloned on the droplet
ROSARIOSIS_TEMPLATE_DIR=/opt/rosariosis-template
# Base vhost directory that will contain per-school installs
VHOST_BASE_DIR=/var/www/vhosts
# File ownership for deployed sites (as created on droplet)
VHOST_OWNER=www-data
VHOST_GROUP=www-data
# Path to RosarioSIS config relative to vhost root
ROSARIOSIS_CONFIG_PATH=config.inc.php

# --- Nginx ---
NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
NGINX_RELOAD_CMD=systemctl reload nginx
NGINX_TEST_CMD=nginx -t
# Base domain for all schools
BASE_DOMAIN=resultapp.org
# Optional: SSL — if you use certbot, set to true to run certbot after site creation
AUTO_SSL=false

# --- Public base URL (links in outgoing email) ---
# Origin users are sent to in verification / password-reset emails.
# MUST include the scheme and have no trailing slash: it is used as
# f"{PUBLIC_BASE_URL}/verify-email?token=..." — a bare "resultapp.org"
# produces an unopenable link.
PUBLIC_BASE_URL=https://resultapp.org
# Optional: where provisioning-failure alerts are delivered (defaults to
# BREVO_SENDER_EMAIL if unset)
# OPS_ALERT_EMAIL=support@resultapp.org

# --- Brevo (Sendinblue) Email ---
BREVO_API_KEY=xkeysib-your-brevo-api-key
# Must be a sender verified in Brevo, otherwise every send fails with 400.
BREVO_SENDER_EMAIL=support@resultapp.org
BREVO_SENDER_NAME=ResultApp
BREVO_WELCOME_TEMPLATE_ID=

# --- Vercel (tenant subdomain registration) ---
# The Next.js app on Vercel serves every tenant subdomain. A hostname Vercel has
# never been told about is not answered, so each new tenant's subdomain is added
# to the project at provision time and Vercel issues it an individual
# certificate.
#
# We deliberately do NOT use a *.resultapp.org wildcard: Vercel can only issue
# that via a DNS-01 challenge requiring Vercel's nameservers to be authoritative
# for resultapp.org, and moving off Cloudflare would break Cloudflare Email
# Routing plus the Brevo DKIM/SPF records.
#
# Token needs access to the project and permission to add domains.
# Leave unset in local dev: domain adds are then skipped and logged.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Scoped team id. Omit for a personal account.
VERCEL_TEAM_ID=

# --- Cloudflare (automatic Vercel verification) ---
# The token needs DNS edit permission for the resultapp.org zone. If it is
# restricted by client IP, use an allowlist entry that matches the address the
# server presents to api.cloudflare.com; the droplet can egress over IPv6 while
# currently being allowlisted by IPv4. The backend always makes Cloudflare API
# calls over IPv4.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# --- App ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# CORS allowed origins (comma separated) — for webhook calls from Next.js/Vercel
CORS_ORIGINS=https://resultapp.org,https://www.resultapp.org,http://localhost:3000
