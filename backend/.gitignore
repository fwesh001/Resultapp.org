# Python bytecode & caches
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
__pycache__/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
env/
ENV/
.conda/

# Environment & secrets - NEVER commit .env
.env
.env.local
.env.*.local
.env.development
.env.production
.env*
*.pem
*.key
secrets/
*.secret

# Logs - never commit runtime logs
logs/
logs/*.log
*.log
provisioning.log

# Local databases
*.sqlite3
*.db
*.sqlite
db.sqlite3

# OS & IDE
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Keep example env (explicit allow if needed elsewhere, but backend ignores .env only)
!.env.example
