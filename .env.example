# === ResultApp Frontend — Environment Template ===
# Copy to .env.local and fill values. NEVER commit .env.local
# .env* is gitignored per .gitignore

# --- Flutterwave ---
# Public key exposed to client (NEXT_PUBLIC_ is intentional for inline checkout)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
# Secret key — SERVER ONLY, never NEXT_PUBLIC_ (used in app/api/provision for verification)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
# Optional: also accepted as FLW_SECRET_KEY
# Optional: webhook verification hash (set in Flutterwave Dashboard → Webhooks)
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your-webhook-verif-hash

# --- Provisioning (DigitalOcean Droplet FastAPI) ---
# URL of your Droplet's FastAPI provisioning service (see backend/.env.example)
# Can be http://YOUR_DROPLET_IP:8000/api/v1/provision or https://api.resultapp.org/api/v1/provision
# Live droplet for Phase 1: http://159.223.178.34:8000/api/v1/provision
PROVISION_API_URL=http://your-droplet-ip:8000/api/v1/provision
# Shared secret — MUST match backend API_SECRET_KEY (server-only, never NEXT_PUBLIC_)
# Phase 1 spec requires BACKEND_API_SECRET; we support BOTH for backward compat (route checks BACKEND_API_SECRET first, fallback PROVISION_API_SECRET)
BACKEND_API_SECRET=change-me-to-long-random-string-min-32-chars
PROVISION_API_SECRET=change-me-to-long-random-string-min-32-chars

# --- Tenant Preview Domain (used by RegisterSchoolForm) ---
# Base domain for live preview (e.g., "Your school will be live at: vhs.resultapp.org")
# Defaults to resultapp.org if unset; set via NEXT_PUBLIC_ so client can read it
NEXT_PUBLIC_BASE_DOMAIN=resultapp.org

# --- Optional: Generic API ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# API_URL=http://localhost:8000

# --- Subdomain Routing ---
# Base URL for the tenant backend API (used by middleware-rendered pages)
# Defaults to http://localhost:3001 when unset.
BACKEND_URL=http://localhost:3001

# --- Superadmin Command Center ---
# Platform-owner password for /superadmin (server-only, never NEXT_PUBLIC_).
# Required — login at /superadmin/login refuses to work without it.
SUPERADMIN_PASSWORD=change-me-to-long-random-string-min-16-chars
