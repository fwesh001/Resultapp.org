# === ResultApp Frontend — Environment Template ===
# Copy to .env.local and fill values. NEVER commit .env.local
# .env* is gitignored per .gitignore

# --- Flutterwave ---
# EXACTLY these three names for live mode. One name per setting on purpose:
# an alias chain is a silent way to lose configuration, and that is how a live
# secret sat unused in .env for months while the TEST key served production.
# Set the webhook URL in Flutterwave Dashboard -> Settings -> Webhooks.
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxx
FLUTTERWAVE_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET_HASH=your-dashboard-secret-hash

# --- Flutterwave: DEMO TENANT ONLY ---
# The demo advertises test card 5531 8866 9555 5447 and a mock bank transfer,
# neither of which a LIVE key accepts, so the demo needs its own TEST key.
# Deliberately a SEPARATE variable rather than a fallback: a fallback is the
# failure mode above. Only ever selected when the registry marks the tenant as
# a demo (data-driven from subscription_status, never the hostname).
NEXT_PUBLIC_FLUTTERWAVE_DEMO_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx

# --- Pending registrations ---
# Encrypts the admin password while a registration is parked server-side between
# checkout and provisioning, so a webhook can finish a registration whose browser
# callback never arrived. Required — the hold endpoint refuses without it.
# Generate with: openssl rand -base64 48
# Deliberately NOT SESSION_SECRET: a shared key would merge "can forge a
# session" and "can read a parked password" into one compromise surface.
PENDING_REGISTRATION_SECRET=

# --- Provisioning (DigitalOcean Droplet FastAPI) ---
# URL of your Droplet's FastAPI provisioning service (see backend/.env.example)
# Can be http://YOUR_DROPLET_IP:8000/api/v1/provision or https://api.resultapp.org/api/v1/provision
# Live droplet for Phase 1: http://159.223.178.34:8000/api/v1/provision
PROVISION_API_URL=http://your-droplet-ip:8000/api/v1/provision
# Shared secret — MUST match backend API_SECRET_KEY (server-only, never NEXT_PUBLIC_)
# Phase 1 spec requires BACKEND_API_SECRET; we support BOTH for backward compat (route checks BACKEND_API_SECRET first, fallback PROVISION_API_SECRET)
BACKEND_API_SECRET=change-me-to-long-random-string-min-32-chars
PROVISION_API_SECRET=change-me-to-long-random-string-min-32-chars

# --- Tenant Preview Domain (used by RegisterSchoolForm) ---
# Base domain for live preview (e.g., "Your school will be live at: vhs.resultapp.org")
# Defaults to resultapp.org if unset; set via NEXT_PUBLIC_ so client can read it
NEXT_PUBLIC_BASE_DOMAIN=resultapp.org

# --- Optional: Generic API ---
# NEXT_PUBLIC_API_URL=http://localhost:8000
# API_URL=http://localhost:8000

# --- Subdomain Routing ---
# Base URL for the tenant backend API (used by middleware-rendered pages)
# Defaults to http://localhost:3001 when unset.
BACKEND_URL=http://localhost:3001

# --- Session signing (P0-0) ---
# HMAC key for the admin_session / staff_session / superadmin_session cookies.
# NEXT.JS ONLY. The FastAPI backend never reads a session cookie (the proxy is
# the sole caller, authenticated by X-API-SECRET-KEY), so this secret must NOT
# be added to backend/.env and must NOT be shared with the droplet.
#
# MUST be >= 32 characters. In production a missing or short value is fatal —
# the app refuses to sign or verify sessions rather than degrading silently.
#
# Do NOT reuse BACKEND_API_SECRET: that key is attached to every X-API-SECRET-KEY
# request, so it already sits outside the Next.js trust boundary.
#
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Rotating this value invalidates every outstanding session immediately
# (all users are signed out). That is the intended emergency kill switch.
# In development, leaving it unset generates an ephemeral per-process secret
# and logs an error; sessions then reset on every restart.
SESSION_SECRET=

# --- Superadmin Command Center ---
# Platform-owner password for /superadmin (server-only, never NEXT_PUBLIC_).
# Required — login at /superadmin/login refuses to work without it.
SUPERADMIN_PASSWORD=change-me-to-long-random-string-min-16-chars

# --- Waiver token recovery (external scheduler) ---
# Shared secret for GET /api/waiver/sweep, which recovers 100%-waiver
# registrations whose browser never finished checkout.
#
# WHAT THIS PROTECTS. A 100% waiver produces no Flutterwave charge, so no
# webhook ever fires for it and the browser callback is the only thing that can
# finish the registration. Without this sweep, a school whose tab closed during
# a fully-waived registration loses their portal AND their waiver code.
#
# HOW TO CALL IT. Three accepted forms, checked in this order:
#   1. Authorization: Bearer <CRON_SECRET>   (Vercel Cron's native header)
#   2. x-cron-secret: <CRON_SECRET>          (schedulers that allow headers)
#   3. https://resultapp.org/api/waiver/sweep?key=<CRON_SECRET>
#
# Form 3 is the one most external schedulers need. cron-job.org's free tier
# cannot set custom headers at all, so without the query parameter there is no
# way for it to authenticate. That does put a secret in a URL, and URLs land in
# access logs — an accepted trade for a revocable token that only unlocks a
# recovery sweep.
#
# NOT SET ON THIS DEPLOYMENT? The route returns 503 with an explanation rather
# than 401, because "I am not configured" and "you are not allowed" are
# different problems and send an operator hunting for the wrong one.
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
