# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# agents
/.agents
# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
.env*
!.env.example
!**/.env.example

# python / backend - ensure sensitive python artifacts never committed
__pycache__/
*.py[cod]
*.pyc
*$py.class
*.so
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# logs
logs/
*.log
npm-install*.log
npm-install-*.log
backend/logs/
provisioning.log

# local databases & secrets
*.sqlite3
*.db
*.sqlite
secrets/
config/secrets/
*.secret

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#mcp
opencode.json

